# pang/.env.example
#
# Copy to `.env.local` (gitignored) and fill in real values.
# Vars without defaults must be set in production via Vercel env.
#
# All vars are validated at module load via `lib/env.ts`. The Zod
# schema there is the source of truth for which are required where.

# ---- App identity ------------------------------------------------

# Public app URL. Used for absolute links in invites + redirects.
# In dev: leave blank (defaults to http://localhost:3000).
NEXT_PUBLIC_APP_URL=

# ---- Auth (PANG signed-link family) ------------------------------

# WebAuthn relying-party id — must be a registrable suffix of the
# origin. Dev: localhost. Prod: pang.app (or wherever).
PANG_AUTH_RP_ID=
PANG_AUTH_RP_NAME=PANG

# Comma-separated list of accepted origins for WebAuthn assertions.
# Dev defaults to localhost trio if blank. Prod must set.
PANG_AUTH_ORIGINS=

# Two distinct ≥32-byte secrets. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
# A compromised invite secret must not let a forged session cookie pass.
PANG_AUTH_INVITE_SECRET=
PANG_AUTH_SESSION_SECRET=

# ---- Supabase (ADR-001 backend) ----------------------------------
# Frankfurt region project. Required in prod.
# Get these from Supabase dashboard → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for Drizzle migrations + queries.
# Format: postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---- Anthropic (ADR-001 AI scan) ---------------------------------
# Used server-side only by /api/scan. Never expose to the client.

ANTHROPIC_API_KEY=

# ---- Cloudflare R2 + Images (ADR-001 artwork media) --------------
# Server-side only.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public account hash for the Cloudflare Images delivery URL.
# Used client-side, hence NEXT_PUBLIC_*.
NEXT_PUBLIC_CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# ---- Observability (ADR-001) -------------------------------------

# Sentry — server + client.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog — EU instance per ADR-001 (eu.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Helicone — Anthropic call audit log.
HELICONE_API_KEY=

# ---- E2E test seam (Playwright) ----------------------------------
# Setting NEXT_PUBLIC_PANG_E2E=1 wires the auth seam that bypasses
# the WebAuthn ceremony. Statically stripped in production bundles.
# Never set in prod.
NEXT_PUBLIC_PANG_E2E=
