{
  "name": "pang-2026",
  "private": true,
  "version": "0.0.0",
  "description": "PANG — a 2026 PWA where art collectors build, verify, and deepen their private collection.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack && tsx scripts/build-sw.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/**/*.test.ts",
    "check:manifest": "tsx scripts/check-manifest.ts",
    "check:gates": "tsx scripts/check-gates.ts",
    "check:strings": "tsx scripts/check-strings.ts",
    "rebuild:voice-prompt": "tsx scripts/rebuild-voice-prompt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-query-persist-client": "^5.80.0",
    "motion": "^12.0.0",
    "next": "^16.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.170.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "workbox-build": "^7.3.0"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0"
  }
}
