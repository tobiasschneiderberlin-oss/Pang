{
  "name": "pang-2026",
  "private": true,
  "version": "0.0.0",
  "description": "PANG — a 2026 PWA where art collectors build, verify, and deepen their private collection.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:device": "tsx scripts/dev-device.ts",
    "build": "next build --webpack && tsx scripts/build-sw.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-test-module-mocks --no-warnings --import tsx --test --test-concurrency=1 --test-reporter=spec $(find src app scripts -name '*.test.ts' -not -path '*/node_modules/*' -not -path '*/__fixtures__/*')",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:manifest": "tsx scripts/check-manifest.ts",
    "check:gates": "tsx scripts/check-gates.ts",
    "check:strings": "tsx scripts/check-strings.ts",
    "check:voice-prompt": "tsx scripts/rebuild-voice-prompt.ts --dry-run",
    "rebuild:voice-prompt": "tsx scripts/rebuild-voice-prompt.ts",
    "build:deepzoom": "tsx scripts/build-deepzoom-pyramids.ts",
    "eval:intake": "tsx evals/intake/run.ts",
    "eval:intake:mock": "PANG_EVAL_MOCK=1 tsx evals/intake/run.ts",
    "eval:enrichment": "tsx evals/enrichment/run.ts",
    "eval:enrichment:mock": "PANG_EVAL_MOCK=1 tsx evals/enrichment/run.ts",
    "eval:correspondence": "tsx evals/correspondence/run.ts",
    "eval:correspondence:mock": "PANG_EVAL_MOCK=1 tsx evals/correspondence/run.ts",
    "eval:narrative": "tsx evals/narrative/run.ts",
    "eval:narrative:mock": "PANG_EVAL_MOCK=1 tsx evals/narrative/run.ts",
    "narrative:tick": "tsx scripts/narrative-tick.ts",
    "eval:verification": "tsx evals/verification/run.ts",
    "check:eval": "npm run eval:intake:mock && npm run eval:enrichment:mock && npm run eval:correspondence:mock && npm run eval:narrative:mock && npm run eval:verification",
    "verify": "npm run typecheck && npm run lint && npm run check:manifest && npm run check:strings && npm run check:voice-prompt && npm run check:gates && npm run check:eval",
    "setup:hooks": "git -C .. config core.hooksPath pang-2026/scripts/git-hooks && echo 'pre-push hook wired. Skip with: git push --no-verify'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^11.0.0",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-query-persist-client": "^5.80.0",
    "jose": "^5.10.0",
    "motion": "^12.0.0",
    "next": "^16.2.4",
    "openseadragon": "^4.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "three": "^0.170.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^22.0.0",
    "@types/openseadragon": "^5.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.2.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "workbox-build": "^7.3.0"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0"
  }
}
