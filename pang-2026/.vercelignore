# PANG — files Vercel does not need when building.
#
# Keeps the build context minimal (faster uploads, less attack
# surface, no noisy logs scrolling test artifacts). Patterns are
# .gitignore syntax; Vercel applies them before uploading to the
# build environment.

# Playwright e2e output (regenerated every CI run).
playwright-report/
test-results/
playwright/.cache/

# Eval fixtures (checked in for reproducibility, but Vercel never
# runs the harness — it's a CI-only gate).
evals/intake/fixtures/*.png

# Dev-only HTTPS certs for `npm run dev:device`.
certificates/

# Editor + OS junk that somehow snuck past .gitignore.
.vscode/
.idea/
.DS_Store
