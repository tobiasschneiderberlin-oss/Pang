# PANG — environment template.
#
# Copy to `.env.local` and fill in. Never commit `.env.local`. Values
# prefixed with NEXT_PUBLIC_ land in the client bundle; everything
# else is server-only (RSC + route handlers only).

# --- Supabase --------------------------------------------------
# Host only (no scheme). next.config.ts joins https:// / wss://.
NEXT_PUBLIC_SUPABASE_HOST=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (server-only) -----------------------------------
ANTHROPIC_API_KEY=

# --- Observability (iteration #5) ------------------------------
# Plausible Cloud through iteration #5, then self-hosted. Leave
# unset in iter #0 — the client is not yet wired.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
