# PANG — environment template.
#
# Copy to `.env.local` and fill in. Never commit `.env.local`. Values
# prefixed with NEXT_PUBLIC_ land in the client bundle; everything
# else is server-only (RSC + route handlers only).

# --- Supabase --------------------------------------------------
# Host only (no scheme). next.config.ts joins https:// / wss://.
NEXT_PUBLIC_SUPABASE_HOST=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (server-only) -----------------------------------
ANTHROPIC_API_KEY=

# --- Observability (iteration #5) ------------------------------
# Plausible Cloud through iteration #5, then self-hosted. Leave
# unset in iter #0 — the client is not yet wired.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Push (iteration #4) ---------------------------------------
# VAPID public key — base64url-encoded P-256 point the user agent
# binds a subscription to. Declarative Web Push for gallery-
# originated verification outcomes only (see CLAUDE.md cannot-do).
# When unset, the client probe returns `{ kind: "unsupported",
# reason: "no-vapid" }` and the in-chip offer never appears — so
# local dev runs cleanly without a real VAPID keypair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The private key stays server-side only; the dispatch worker in
# iteration #7 signs push payloads with it. Never exposed to the
# client, never logged.
VAPID_PRIVATE_KEY=
# Contact identifier the push service uses if the subscription
# goes wrong — RFC 8292 recommends a mailto or https URL.
VAPID_CONTACT=mailto:ops@example.com

# --- Anthropic model overrides (A19) ---------------------------
# Per-agent model IDs live in `src/ai/agents/models.ts`. Production
# defaults are pinned there; these env vars let you swap a single
# agent's model without a code change (useful for A22 eval runs
# comparing variants). Each override takes precedence over the
# default only if set + non-empty. Changing a production model
# still requires running the eval corpus and logging the pass-rate
# delta in PANG_Aha_Sprint.md.
# ANTHROPIC_MODEL_INTAKE=claude-sonnet-4-6
# ANTHROPIC_MODEL_INTAKE_Q=claude-haiku-4-6
# ANTHROPIC_MODEL_ENRICHMENT=claude-sonnet-4-6
# ANTHROPIC_MODEL_NARRATIVE=claude-sonnet-4-6
# ANTHROPIC_MODEL_CORRESPONDENCE=claude-sonnet-4-6

# --- Dev / test toggles (not .env.local candidates) -----------
# Shell env vars, listed here so `grep PANG .env.example` finds
# everything. Do NOT uncomment — set inline when running commands.
#
# PANG_STRICT=1         CI gate mode: skip → fail. Mirrors ci.yml.
# PANG_EVAL_MOCK=1      A22 eval harness uses canned responses,
#                       no Anthropic calls. CI default; also safe
#                       for local sanity checks.
# PANG_E2E_BASE_URL=... Point Playwright at a preview deploy
#                       instead of localhost. Skips the local
#                       webServer spawn.
